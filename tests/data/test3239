<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
proxy
haproxy
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 6
Connection: close
Content-Type: text/html

-foo-
</data>
</reply>

# Client-side
<client>
<server>
http
</server>
<name>
HTTP GET with PROXY protocol v2 and spoofed client IPv6
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --haproxy-protocol-v2 --haproxy-clientip "2a04:4e42::347" -H "Testno: %TESTNUMBER"
</command>
<features>
proxy
</features>
</client>

# Verify data after the test has been "shot"
#
# The connection itself is made over IPv4, but the spoofed client address is
# an IPv6 one. The address family of the header is decided by the spoofed
# address, so an AF_INET6 header with a 36 byte address block is sent while
# the ports remain those of the real IPv4 connection.
<verify>
<postcheck>
%PERL %SRCDIR/test3234.pl %LOGDIR/server.input tcp6 src=2a04:4e42::347 dst=2a04:4e42::347 sport=nonzero dport=%HTTPPORT req=%TESTNUMBER
</postcheck>
</verify>
</testcase>
