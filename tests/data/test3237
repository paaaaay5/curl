<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
proxy
haproxy
UnixSockets
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 6
Connection: close
Content-Type: text/html

-foo-
</data>
</reply>

# Client-side
<client>
<features>
proxy
UnixSockets
</features>
<server>
http-unix
</server>
<name>
HTTP GET over Unix socket with PROXY protocol v2 and spoofed client IP
</name>
<command>
--unix-socket %HTTPUNIXPATH http://%HOSTIP/%TESTNUMBER --haproxy-protocol-v2 --haproxy-clientip "1.2.3.4" -H "Testno: %TESTNUMBER"
</command>
</client>

# Verify data after the test has been "shot"
#
# Even though the connection is made over a Unix socket, a spoofed client IP
# must still be reported. curl emits an AF_INET v2 header (family byte 0x11)
# with the address as both source and destination; the ports of a Unix socket
# connection are not available, so they are zero.
<verify>
<postcheck>
%PERL %SRCDIR/test3234.pl %LOGDIR/server.input tcp4 src=1.2.3.4 dst=1.2.3.4 sport=0 dport=0 req=%TESTNUMBER
</postcheck>
</verify>
</testcase>
