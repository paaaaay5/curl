<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
proxy
haproxy
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 6
Connection: close
Content-Type: text/html

-foo-
</data>
</reply>

# Client-side
<client>
<server>
http
</server>
<name>
HTTP GET with PROXY protocol v2 and spoofed client IPv4
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --haproxy-protocol-v2 --haproxy-clientip "1.2.3.4" -H "Testno: %TESTNUMBER"
</command>
<features>
proxy
</features>
</client>

# Verify data after the test has been "shot"
#
# With a spoofed client IP the v2 header must report that address as both the
# source and destination address (matching the version 1 behavior). The ports
# remain those of the actual connection, so the random source port is only
# checked for being set at all.
<verify>
<postcheck>
%PERL %SRCDIR/test3234.pl %LOGDIR/server.input tcp4 src=1.2.3.4 dst=1.2.3.4 sport=nonzero dport=%HTTPPORT req=%TESTNUMBER
</postcheck>
</verify>
</testcase>
