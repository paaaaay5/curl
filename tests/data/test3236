<testcase>
<info>
<keywords>
HTTP
HTTP GET
proxy
haproxy
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 6
Connection: close
Content-Type: text/html

-foo-
</data>
</reply>

# Client-side
<client>
<server>
http
</server>
<name>
HTTP GET with PROXY protocol v2 and spoofed client UNIX path (AF_UNIX)
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --haproxy-protocol-v2 --haproxy-clientpath "/run/client.sock" -H "Testno: %TESTNUMBER"
</command>
<features>
proxy
</features>
</client>

# Verify data after the test has been "shot"
#
# --haproxy-clientpath makes curl emit an AF_UNIX v2 header (family/transport
# byte 0x31) with a 216 byte address block: a 108 byte NUL-padded source path
# followed by a 108 byte NUL-padded destination path, both set to the supplied
# path. The AF_UNIX family carries no ports at all.
<verify>
<postcheck>
%PERL %SRCDIR/test3234.pl %LOGDIR/server.input unix src=/run/client.sock dst=/run/client.sock req=%TESTNUMBER
</postcheck>
</verify>
</testcase>
